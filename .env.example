# Fonte de dados: "demo" (em memória, sem banco) ou "mysql" (banco do NewsBot).
# Se DATABASE_URL não estiver definida, o painel usa "demo" automaticamente.
DATA_SOURCE=demo

# Conexão com o MySQL do NewsBot (obrigatória no modo mysql).
# Formato: mysql://usuario:senha@host:3306/banco
DATABASE_URL=

# Senha única de acesso ao painel. Vazia = autenticação desligada (só faça isso em demo).
PAINEL_SENHA=

# Segredo usado para assinar o cookie de sessão (HMAC-SHA256). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL pública do WordPress onde o NewsBot publica. Usada para montar o link /?p=<post_id_wp>.
WORDPRESS_URL=https://exemplo.com.br

# Fuso horário do servidor. Use o mesmo do n8n e do MySQL para que "hoje" bata nas métricas.
TZ=America/Sao_Paulo

# Porta do servidor Next.js (padrão 3000).
PORT=3000
